<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cc.misshi.springai</groupId>
    <artifactId>spring-ai-2-0-projects-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Spring AI 2.0 Projects · Parent</name>
    <description>Spring AI 2.0 项目实战重做版 - monorepo 聚合 POM</description>

    <modules>
        <!-- Phase 1: 基础筑基 -->
        <module>01-basics/01-hello-world</module>
        <module>01-basics/02-chatclient-api</module>
        <module>01-basics/03-prompt-advisor</module>
        <module>01-basics/04-function-calling</module>
        <module>01-basics/05-structured-output</module>
        <module>01-basics/06-streaming</module>
        <!-- Phase 2: RAG 实战 -->
        <module>02-rag/07-rag-overview</module>
        <module>02-rag/08-pgvector</module>
        <module>02-rag/09-document-loaders</module>
        <module>02-rag/10-advanced-rag</module>
        <module>02-rag/11-reranking</module>
        <module>02-rag/12-rag-production</module>
        <!-- Phase 3: Agent -->
        <module>03-agent/13-agent-basics</module>
        <module>03-agent/14-tool-calling</module>
        <module>03-agent/15-mcp</module>
        <module>03-agent/16-multi-agent</module>
        <module>03-agent/17-spring-ai-graph</module>
        <module>03-agent/18-agent-production</module>
        <!-- Phase 4: 实战项目 -->
        <module>04-projects/project-1-weekly-report</module>
        <module>04-projects/project-2-doc-qa</module>
        <module>04-projects/project-3-travel-planner</module>
        <module>04-projects/project-4-code-review</module>
        <module>04-projects/project-5-knowledge-hub</module>
        <!-- 后续 chapter 边做边加 -->
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>4.0.0</spring-boot.version>
        <spring-ai.version>2.0.0</spring-ai.version>

        <mockito.version>5.11.0</mockito.version>
        <assertj.version>3.25.3</assertj.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM(自带 JUnit 5 / Mockito / AssertJ 管理) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring AI BOM -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
